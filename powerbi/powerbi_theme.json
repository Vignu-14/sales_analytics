{
  "name": "Sales Performance Theme",
  "background": "#F0F2F5",
  "foreground": "#333333",
  "tableAccent": "#F4B942",
  "dataColors": [
    "#1B2A4A",
    "#F4B942",
    "#2ECC71",
    "#E74C3C",
    "#3498DB",
    "#9B59B6",
    "#E67E22",
    "#1ABC9C"
  ],
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 14,
            "color": {
              "solid": {
                "color": "#1B2A4A"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#333333"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F0F2F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
